# Variables para envio de correo de registro (Resend)
# Consigue tu clave en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente: en pruebas usa onboarding@resend.dev (solo entrega al dueño de la cuenta Resend)
# Para enviar a CUALQUIER correo verifica un dominio en Resend y usa: Tareas <noreply@tudominio.com>
RESEND_FROM=Tareas <onboarding@resend.dev>
